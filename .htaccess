# ============================================
# HEADERS DE SÉCURITÉ - VERSION FINALE
# Application Étiquettes v1.0.11
# ============================================

RewriteEngine On

# Rediriger vers index.php si le fichier n'existe pas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "\.(sql|md|env|git|gitignore|htaccess|htpasswd|ini|log|sh|bak|backup|old|tmp|swp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================
# HEADERS DE SÉCURITÉ
# ============================================

<IfModule mod_headers.c>
    # Anti-Clickjacking : Empêche l'intégration du site dans une iframe
    Header set X-Frame-Options "SAMEORIGIN"

    # Anti-MIME Sniffing : Force le navigateur à respecter le Content-Type
    Header set X-Content-Type-Options "nosniff"

    # Protection XSS : Filtre XSS intégré (navigateurs anciens)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy : Contrôle les informations envoyées dans le header Referer
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy : Désactive les APIs non utilisées
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
</IfModule>

# ============================================
# PROTECTION FICHIERS SENSIBLES (renforcée)
# ============================================

# Bloquer l'accès direct aux dossiers sensibles
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Protection config
<FilesMatch "^(config\.php|database\.php)">
    Order allow,deny
    Deny from all
</FilesMatch>
