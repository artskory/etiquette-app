# ============================================
# RÉÉCRITURE D'URL + HEADERS DE SÉCURITÉ
# Application Étiquettes v2.0.0
# ============================================

RewriteEngine On
RewriteBase /etiquette-app/

# Forcer le passage par index.php pour les extensions sensibles (même si le fichier existe)
RewriteCond %{REQUEST_URI} \.(sql|md|env|gitignore|htpasswd|ini|log|sh|bak|backup|old|tmp|swp|git)$ [NC]
RewriteRule ^(.*)$ index.php [QSA,L]

# Ne pas réécrire les fichiers et dossiers existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tout rediriger vers index.php en passant le chemin complet
RewriteRule ^(.*)$ index.php [QSA,L]


# Les extensions sensibles sont gérées par index.php

# ============================================
# HEADERS DE SÉCURITÉ
# ============================================

<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Type MIME correct pour le webmanifest
    <FilesMatch "\.webmanifest$">
        Header set Content-Type "application/manifest+json"
    </FilesMatch>
</IfModule>

# ============================================
# PROTECTION FICHIERS SENSIBLES
# ============================================

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^(config\.php|database\.php)">
    <IfVersion >= 2.4>
        Require all denied
    </IfVersion>
    <IfVersion < 2.4>
        Order allow,deny
        Deny from all
    </IfVersion>
</FilesMatch>

